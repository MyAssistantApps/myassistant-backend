# Copy to /opt/myassistant/monitoring/monitoring.env (chmod 600) and fill in.
# Never commit the real file.

# Grafana login (user "admin") at https://backend.envisionsit.in/grafana/
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random

# postgres-exporter: a read-only view of the database. Use the same
# password as POSTGRES_PASSWORD in /opt/myassistant/pg.env.
DATA_SOURCE_NAME=postgresql://myassistant:CHANGE_ME@postgres:5432/myassistant?sslmode=disable

# Also create /opt/myassistant/monitoring/metrics_token (chmod 600) holding
# the same value as METRICS_TOKEN in /opt/myassistant/.env — Prometheus sends
# it to the backend's /metrics as a bearer token.
